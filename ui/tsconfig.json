{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "module": "es2015",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "downlevelIteration": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "target": "es5",
    "typeRoots": [
      "node_modules/@types",
      "../node_modules/@types"
    ],
    // Without this every @types package pulled in transitively is loaded as a
    // global type library, and the stub packages among them (@types/minimatch
    // ships no declarations) fail the build. Only the globals this app uses
    // belong here: `ga` from google.analytics, `NodeJS.Timer` from node.
    "types": [
      "google.analytics",
      "node"
    ],
    "lib": [
      "es2018",
      "dom"
    ],
    "paths": {
      "@eqmac/components": ["../modules/components/src"]
    }
  }
}
