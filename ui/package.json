{
  "name": "ui",
  "version": "4.0.0",
  "private": true,
  "scripts": {
    "lint": "npx eslint .",
    "start": "ng serve --port 8080 --host 0.0.0.0",
    "dev": "ng serve --configuration harness --port 8081 --open",
    "build": "rm -rf dist/ && ng build --configuration production && node -e \"console.log(require('./package.json').version)\" > dist/version.txt && cd dist/ && zip -r -D ui.zip * -x '*.DS_Store' && cp ui.zip ../../native/app/Embedded"
  },
  "dependencies": {
    "@angular/common": "~22.1.0",
    "@angular/compiler": "~22.1.0",
    "@angular/core": "~22.1.0",
    "@angular/forms": "~22.1.0",
    "@angular/platform-browser": "~22.1.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.0"
  },
  "devDependencies": {
    "@angular/build": "~22.1.0",
    "@angular/cli": "~22.1.2",
    "@angular/compiler-cli": "~22.1.0",
    "typescript": "~6.0.3"
  }
}
